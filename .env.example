# Docker Compose development environment variables

# PostgreSQL
POSTGRES_USER=yimatong
POSTGRES_PASSWORD=yimatong
POSTGRES_DB=yimatong_dev

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Application (used by backend, worker, migration services)
DATABASE_URL=postgresql+asyncpg://yimatong:yimatong@postgres:5432/yimatong_dev
CALLBACK_DATABASE_URL=postgresql+asyncpg://yimatong_callback:yimatong_callback@postgres:5432/yimatong_dev
REDIS_URL=redis://redis:6379/0
SECRET_KEY=dev-secret-key-change-in-production
