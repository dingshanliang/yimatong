# Database
database_url=postgresql+asyncpg://yimatong_app:yimatong_app@localhost:5433/yimatong_dev
migration_database_url=postgresql+asyncpg://yimatong:yimatong@localhost:5433/yimatong_dev
# Only controlled cross-tenant bootstrap/platform/auth code uses this pool.
control_database_url=postgresql+asyncpg://yimatong:yimatong@localhost:5433/yimatong_dev

# Redis
redis_url=redis://localhost:6379/0

# Optional controlled DNS/TLS settings for takeover acceptance; defaults use system DNS and 443.
takeover_dns_nameserver=
takeover_dns_port=53
takeover_tls_port=443
takeover_tls_ca_file=
# Exact ingress/H5 proxy networks allowed to set X-Forwarded-For.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Security
ENVIRONMENT=development
secret_key=dev-secret-key-change-in-production
access_token_expire_minutes=15
refresh_token_expire_days=7

# Canonical brand Admin public origin used for invite, activation, and password-reset links.
# Production must set an explicit public HTTPS origin with no path, query, or credentials.
ADMIN_PUBLIC_URL=http://localhost:3000

# Canonical consumer H5 origin used for WeChat OAuth return redirects.
# Production must set an explicit public HTTPS origin with no path, query, or credentials.
H5_PUBLIC_URL=http://localhost:3001

# Canonical Platform frontend origin used for cookie CSRF validation.
PLATFORM_PUBLIC_URL=http://localhost:3002

# Platform Admin (bcrypt hash of password)
platform_admin_email=platform@yimatong.cn
platform_admin_password_hash=$2b$12$<generate-with-python-bcrypt>

# Crypto (generate with: python -c "import secrets; print(secrets.token_hex(32))")
AES_MASTER_KEY_V1=
HMAC_PEPPER=
