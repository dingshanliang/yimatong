{
  "name": "@yimatong/design-tokens",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./tokens": "./tokens.ts",
    "./theme.css": "./dist/theme.css",
    "./preview": "./preview/index.html"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build-css.mjs",
    "check:generated": "node --experimental-strip-types scripts/build-css.mjs --check",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm check:generated && pnpm test && pnpm typecheck"
  },
  "peerDependencies": {
    "antd": "^6.4.3"
  },
  "devDependencies": {
    "antd": "^6.4.3",
    "typescript": "^5"
  }
}
